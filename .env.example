# Hostinger Node runtime
HOST=0.0.0.0
PORT=3000
NITRO_HOST=0.0.0.0
NITRO_PORT=3000

# Hostinger Email SMTP
# SMTP_PASS is the only mandatory secret. The application defaults the remaining
# public values below, but they are listed for explicit Hostinger configuration.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=support@baristo.online
SMTP_PASS=replace_with_actual_mailbox_password
SMTP_FROM=support@baristo.online
RESERVATION_TO=support@baristo.online
FIRST_POUR_TO=support@baristo.online
