{
  "version": 1,
  "sdk_version": "0.23.0",
  "path": "/mcp",
  "auth": {
    "type": "none"
  },
  "mcp": {
    "server": {
      "name": "baristo-mcp",
      "version": "0.1.0",
      "title": "Baristo.Online MCP"
    },
    "tools": [
      {
        "name": "list_roasts",
        "title": "List Baristo roasts",
        "description": "List all Baristo.Online single-origin roasts (Medium, Medium-Dark, Truly Dark) with tasting notes, intensity, pricing (INR), and pouch size.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "get_roast",
        "title": "Get Baristo roast details",
        "description": "Get full details for one Baristo roast by key: medium, medium-dark, or truly-dark.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "roastKey": {
              "type": "string",
              "enum": [
                "medium",
                "medium-dark",
                "truly-dark"
              ],
              "description": "The roast key"
            }
          },
          "required": [
            "roastKey"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "list_case_packs",
        "title": "List Baristo case packs",
        "description": "List all 10-pack Baristo case collections (single-roast, discovery, executive, altitude) with pack split, total, MRP, and launch pricing in INR.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_recipes",
        "title": "List Baristo recipes",
        "description": "List Baristo recipes with optional filters by roast (Medium, Medium-Dark, Truly Dark) and brew method (Moka Pot, French Press, Pour-Over, Espresso). Returns a summary; use get_recipe for full brewing steps.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "roast": {
              "type": "string",
              "enum": [
                "Medium",
                "Medium-Dark",
                "Truly Dark"
              ]
            },
            "brewMethod": {
              "type": "string",
              "enum": [
                "Moka Pot",
                "French Press",
                "Pour-Over",
                "Espresso"
              ]
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "get_recipe",
        "title": "Get Baristo recipe",
        "description": "Get full details for one Baristo recipe by slug — ingredients, step-by-step brew instructions, tasting notes, and pairing.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "slug": {
              "type": "string",
              "minLength": 1,
              "description": "Recipe slug, e.g. baristo-classic, sage, zen"
            }
          },
          "required": [
            "slug"
          ]
        },
        "outputSchema": null
      }
    ]
  }
}
